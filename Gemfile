source "https://rubygems.org"

# Pin the exact gem set GitHub Pages builds with, so local == production.
gem "github-pages", group: :jekyll_plugins

# Required by the So Simple theme; not always pulled in transitively.
gem "jekyll-include-cache", group: :jekyll_plugins

# Removed from the Ruby 3.x standard library; needed by `jekyll serve`.
gem "webrick", "~> 1.8"
